{
  "name": "@polymitapay/mcp",
  "version": "0.1.6",
  "description": "MCP server an end user installs into their agent to consume the PolyPay catalog with x402 auto-payment over XRPL",
  "type": "module",
  "engines": {
    "node": ">=20.12.0"
  },
  "bin": {
    "polymitapay-mcp": "dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx --env-file=.env src/index.ts",
    "build": "tsc"
  },
  "keywords": [
    "mcp",
    "x402",
    "xrpl"
  ],
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@x402/core": "^2.22.0",
    "@x402/mcp": "^2.22.0",
    "@x402/xrpl": "^2.22.0",
    "xrpl": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
