# Copy to .env and fill in your own values. .env is gitignored -- never
# commit a real seed.

POLYPAY_WALLET_SEED=
POLYPAY_API_URL=https://api.polymitapay.com
POLYPAY_NETWORK=testnet

# All optional -- omitted means no limit (same as before these existed).
# XRP amounts are plain XRP (e.g. "5"), RLUSD amounts are plain RLUSD/USD
# (e.g. "2"). MAX_TOTAL is per process run, not persisted across restarts.
POLYPAY_MAX_PER_CALL_XRP=
POLYPAY_MAX_PER_CALL_RLUSD=
POLYPAY_MAX_TOTAL_XRP=
POLYPAY_MAX_TOTAL_RLUSD=
